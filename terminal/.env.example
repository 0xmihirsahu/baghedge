# server only. never prefix these with NEXT_PUBLIC_, that ships them to the browser
# alchemy reads watched balances; the free publicnode rpc covers it if alchemy fails
ALCHEMY_API_KEY=
# the baghedge backend; its /api paths are proxied under this origin (docs/INTEGRATION.md)
BAGHEDGE_API_URL=https://baghedge-api.onrender.com
# pin the network the UI reads (mainnet | testnet). unset: follow the backend's /api/health. hedges only go live
# when the backend runs the same network
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_PRIVY_APP_ID=
