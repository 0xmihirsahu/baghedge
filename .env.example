# Baghedge backend configuration. Copy to .env.testnet / .env.mainnet (gitignored) and fill in.
# Run with: bun run start:testnet  or  bun run start:mainnet
# On Render, set the same keys in the dashboard (Environment) — never commit real values.

# ---- core ----
APP_MODE=testnet                    # testnet | mainnet
PORT=3001
HOST=127.0.0.1                      # 0.0.0.0 on Render (requires an https APP_ORIGIN)
APP_ORIGIN=http://localhost:5173    # the terminal's origin, e.g. https://app.baghedge.xyz (session challenges are bound to it)
BAGHEDGE_DB_PATH=data/baghedge.sqlite   # /var/data/baghedge.sqlite on Render
WORKER=1                            # 0 disables the hedge worker
OPS_PAGE=0                          # 1 enables the localhost-only /ops owner console

# ---- providers ----
SOLANA_RPC_URL=                     # recommended: a Helius/QuickNode URL (secret). Default: public devnet/mainnet RPC
INTENTS_BASE_URL=https://1click.chaindefuser.com
INTENTS_JWT=                        # optional 1Click JWT (secret)

# ---- hedge signer: pick one ----
HEDGE_SIGNER=                       # guard | fallback | (empty = no hedging, quotes/reads only)

# guard (OutLayer, mainnet): from the attested build
OUTLAYER_CALLER=                    # NEAR executor account, e.g. anotherbaghedge.near
OUTLAYER_NEAR_PRIVATE_KEY=          # ed25519:... of the executor (secret)
OUTLAYER_WASM_URL=                  # https://main.fastfs.io/<caller>/fastfs.near/<sha256>.wasm
OUTLAYER_WASM_SHA256=               # 0x<sha256 of the wasm>
OUTLAYER_PINNED_OWNER=              # public: the Hedge owner compiled into a single-owner guard build (others are refused up front)
OUTLAYER_AGENT_ADDRESS=             # single-owner mode: agent from the attested public_key run
# OUTLAYER_MULTI_OWNER=1           # per-owner agents (one attested build serves every Hedge owner); needs the multi-owner build
# OUTLAYER_DISCOVERY_PER_HOUR=30    # global cap on paid agent lookups for new owners
# OUTLAYER_NEAR_RPC_URL=            # optional RPC override

# fallback (labeled demo signer, testnet only)
FALLBACK_AGENT_PRIVATE_KEY=         # 0x... (secret)
ALLOW_MAINNET_FALLBACK=             # labeled-demo to allow on mainnet (not recommended)

# ---- ops console ----
WALLETCONNECT_PROJECT_ID=           # from cloud.reown.com; lets phone wallets connect to /ops

# One log line per API request (method, path, status, duration, error code; no query, headers or bodies). 0 = off.
# LOG_REQUESTS=1
